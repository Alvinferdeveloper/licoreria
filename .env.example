# Copy to .env and adjust. Never commit .env.

# Database (compose service "db")
DB_NAME=licoreria
DB_USER=licoreria
DB_PASSWORD=change-me
DB_PORT=5432

# Published ports listen only on this machine. Use 0.0.0.0 to reach them from a tablet on the LAN.
BIND_ADDR=127.0.0.1

# Web (compose service "web")
WEB_PORT=3000
# Public domain for HTTPS, used by `--profile production`
DOMAIN=

# API (compose service "api")
API_PORT=8080
APP_ENV=development
LOG_LEVEL=info
# text (readable, default in development) or json (default in production)
LOG_FORMAT=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public web URL used in email links
APP_BASE_URL=http://localhost:3000

# Auth: at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-of-32-bytes-or-more
# Optional overrides: ACCESS_TOKEN_TTL=15m REFRESH_TOKEN_TTL=168h RESET_TOKEN_TTL=30m
# COOKIE_SECURE defaults to true in production and false in development
COOKIE_SECURE=

# Mail. Defaults point at the Mailpit container (UI on http://localhost:8025): nothing
# reaches a real inbox. With RESEND_API_KEY set, mail goes out through Resend's API and
# the SMTP_* values are ignored. MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Añejo <no-reply@anejo.local>
MAILPIT_UI_PORT=8025

# Product images (Supabase Storage). Create a PUBLIC bucket named like SUPABASE_BUCKET.
# Project Settings > API: copy the project URL and the service_role key (server only, never in the web app).
# Leave empty to run without image uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=productos
# Optional offsite copy of backups. Must be a PRIVATE bucket, never the one above:
# a backup holds password hashes and customer data. Leave empty to keep them only on the server.
SUPABASE_BACKUP_BUCKET=
MAILPIT_SMTP_PORT=1025

# Running the API outside containers (go run ./cmd/api) also needs:
# DATABASE_URL=postgres://licoreria:change-me@localhost:5432/licoreria?sslmode=disable
# SMTP_HOST=localhost
# BACKUP_DIR=./backups (needs pg_dump, pg_restore and psql in the PATH)
# Integration tests (go test ./...) use a separate database:
# TEST_DATABASE_URL=postgres://licoreria:change-me@localhost:5432/licoreria_test?sslmode=disable
