// Diagrama entidad-relación de Añejo, generado desde la base de datos real.
// Ábrelo en https://dbdiagram.io (Import > DBML) para verlo y exportarlo.

Project anejo {
  database_type: 'PostgreSQL'
  Note: 'Punto de venta e inventario para licorerías. 33 tablas, 49 relaciones.'
}

Table users [headercolor: #8C3B2E] {
  id uuid [pk]
  full_name text [not null]
  email citext [unique]
  username citext [not null, unique]
  password_hash text [not null]
  pin_hash text
  role_id uuid [not null]
  active boolean [not null, default: true]
  must_change_password boolean [not null, default: true]
  password_expires_at timestamptz
  failed_attempts integer [not null, default: 0]
  locked_until timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  activated_at timestamptz

  Note: 'Personas que entran al sistema. Contraseña y PIN solo como hash (Argon2id).'
}

Table roles [headercolor: #8C3B2E] {
  id uuid [pk]
  code text [unique]
  name text [not null, unique]
  description text [not null, default: '']
  is_system boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Roles configurables; el Administrador no se puede editar.'
}

Table permissions [headercolor: #8C3B2E] {
  id uuid [pk]
  module text [not null]
  action text [not null]
  description text [not null, default: '']

  indexes {
    (module, action) [unique]
  }

  Note: 'Catálogo de permisos módulo:acción.'
}

Table role_permissions [headercolor: #8C3B2E] {
  role_id uuid [not null]
  permission_id uuid [not null]

  indexes {
    (role_id, permission_id) [pk]
  }

  Note: 'Qué permisos tiene cada rol.'
}

Table refresh_sessions [headercolor: #8C3B2E] {
  id uuid [pk]
  user_id uuid [not null]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  ip inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  Note: 'Sesiones abiertas; el refresh token rota y se detecta su reutilización.'
}

Table auth_tokens [headercolor: #8C3B2E] {
  id uuid [pk]
  user_id uuid [not null]
  token_hash text [not null, unique]
  purpose text [not null]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'Enlaces de un solo uso: invitación y recuperación de contraseña.'
}

Table password_history [headercolor: #8C3B2E] {
  id uuid [pk]
  user_id uuid [not null]
  password_hash text [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Últimas contraseñas, para no repetirlas.'
}

Table schedule_extensions [headercolor: #8C3B2E] {
  id uuid [pk]
  user_id uuid
  ends_at timestamptz [not null]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Extensiones del horario de uso para un usuario o para todos.'
}

Table audit_log [headercolor: #8C3B2E] {
  id uuid [pk]
  user_id uuid
  action text [not null]
  entity text [not null]
  entity_id uuid
  before_data jsonb
  after_data jsonb
  ip inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  Note: 'Bitácora de solo agregar: un trigger impide UPDATE y DELETE.'
}

Table products [headercolor: #B5651D] {
  id uuid [pk]
  sku citext [not null, unique]
  barcode text [unique]
  name text [not null]
  description text [not null, default: '']
  category_id uuid [not null]
  brand_id uuid
  unit_id uuid [not null]
  alcohol_percent "numeric(4,1)"
  volume_ml integer
  image_url text
  price "numeric(14,2)" [not null]
  average_cost "numeric(14,4)" [not null, default: 0]
  tax_percent "numeric(5,2)" [not null, default: 15]
  stock integer [not null, default: 0]
  min_stock integer [not null, default: 0]
  reorder_point integer [not null, default: 0]
  allow_negative_stock boolean [not null, default: false]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Catálogo. stock lo mantiene un trigger del kardex; average_cost es el costo promedio ponderado.'
}

Table product_presentations [headercolor: #B5651D] {
  id uuid [pk]
  product_id uuid [not null]
  name text [not null]
  factor integer [not null]
  barcode text [unique]
  price "numeric(14,2)" [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id, name) [unique]
  }

  Note: 'Six-pack, caja, etc.: factor en unidades base y precio propio.'
}

Table categories [headercolor: #B5651D] {
  id uuid [pk]
  name text [not null]
  parent_id uuid
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Categorías del catálogo.'
}

Table brands [headercolor: #B5651D] {
  id uuid [pk]
  name citext [not null, unique]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Marcas.'
}

Table units [headercolor: #B5651D] {
  id uuid [pk]
  name citext [not null, unique]
  abbreviation citext [not null, unique]

  Note: 'Unidades de medida (botella, lata, bolsa...).'
}

Table sales [headercolor: #2F6B4F] {
  id uuid [pk]
  invoice_series text [not null]
  invoice_number integer [not null]
  shift_id uuid [not null]
  register_id uuid [not null]
  user_id uuid [not null]
  customer_id uuid [not null]
  customer_name text [not null]
  customer_tax_id text
  subtotal "numeric(14,2)" [not null]
  discount "numeric(14,2)" [not null, default: 0]
  tax "numeric(14,2)" [not null]
  total "numeric(14,2)" [not null]
  exchange_rate "numeric(12,6)" [not null]
  change_nio "numeric(14,2)" [not null, default: 0]
  change_usd "numeric(14,2)" [not null, default: 0]
  age_verified boolean [not null]
  discount_authorized_by uuid
  status text [not null, default: 'completed']
  voided_at timestamptz
  voided_by uuid
  void_reason text
  idempotency_key uuid [not null, unique]
  notes text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
  offline_at timestamptz

  indexes {
    (invoice_series, invoice_number) [unique]
  }

  Note: 'Factura emitida. Guarda la tasa, el descuento autorizado y offline_at si se hizo sin conexión.'
}

Table sale_items [headercolor: #2F6B4F] {
  id uuid [pk]
  sale_id uuid [not null]
  product_id uuid [not null]
  presentation_id uuid
  product_name text [not null]
  sku text [not null]
  quantity integer [not null]
  units_per_item integer [not null, default: 1]
  unit_price "numeric(14,2)" [not null]
  unit_cost "numeric(14,4)" [not null, default: 0]
  discount "numeric(14,2)" [not null, default: 0]
  tax_percent "numeric(5,2)" [not null]
  tax "numeric(14,2)" [not null]
  subtotal "numeric(14,2)" [not null]
  total "numeric(14,2)" [not null]

  Note: 'Foto de cada línea: precio, costo e IVA del momento de la venta.'
}

Table sale_payments [headercolor: #2F6B4F] {
  id uuid [pk]
  sale_id uuid [not null]
  method text [not null]
  currency_code character [not null]
  amount "numeric(14,2)" [not null]
  exchange_rate "numeric(12,6)" [not null]
  amount_nio "numeric(14,2)" [not null]
  reference text
  created_at timestamptz [not null, default: `now()`]

  Note: 'Pagos por moneda y método; referencia del voucher en tarjeta o transferencia.'
}

Table returns [headercolor: #2F6B4F] {
  id uuid [pk]
  sale_id uuid [not null]
  shift_id uuid [not null]
  reason text [not null]
  refund_total "numeric(14,2)" [not null]
  authorized_by uuid [not null]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Devoluciones de clientes (estructura lista).'
}

Table return_items [headercolor: #2F6B4F] {
  id uuid [pk]
  return_id uuid [not null]
  sale_item_id uuid [not null]
  quantity integer [not null]
  restock boolean [not null]
  amount "numeric(14,2)" [not null]

  Note: 'Líneas de cada devolución.'
}

Table customers [headercolor: #2F6B4F] {
  id uuid [pk]
  full_name text [not null]
  tax_id citext [unique]
  phone text
  email citext
  birth_date date
  address text [not null, default: '']
  is_walk_in boolean [not null, default: false]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Clientes; uno es «Consumidor final».'
}

Table registers [headercolor: #2E5A88] {
  id uuid [pk]
  name text [not null, unique]
  invoice_series text [not null, unique]
  next_invoice_number integer [not null, default: 1]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Cajas físicas, cada una con su serie de facturas.'
}

Table cash_shifts [headercolor: #2E5A88] {
  id uuid [pk]
  register_id uuid [not null]
  user_id uuid [not null]
  status text [not null, default: 'open']
  opened_at timestamptz [not null, default: `now()`]
  closed_at timestamptz
  opening_nio "numeric(14,2)" [not null, default: 0]
  opening_usd "numeric(14,2)" [not null, default: 0]
  expected_nio "numeric(14,2)"
  expected_usd "numeric(14,2)"
  counted_nio "numeric(14,2)"
  counted_usd "numeric(14,2)"
  difference_nio "numeric(14,2)"
  difference_usd "numeric(14,2)"
  notes text [not null, default: '']

  Note: 'Turno de caja: fondo inicial, esperado, contado y diferencia por moneda.'
}

Table cash_movements [headercolor: #2E5A88] {
  id uuid [pk]
  shift_id uuid [not null]
  type text [not null]
  currency_code character [not null]
  amount "numeric(14,2)" [not null]
  reason text [not null]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Entradas y salidas de efectivo durante el turno.'
}

Table currencies [headercolor: #2E5A88] {
  code character [pk]
  symbol text [not null]
  name text [not null]
  is_base boolean [not null, default: false]

  Note: 'Monedas: C$ base y US$.'
}

Table exchange_rates [headercolor: #2E5A88] {
  id uuid [pk]
  currency_code character [not null]
  rate "numeric(12,6)" [not null]
  effective_date date [not null]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (currency_code, effective_date) [unique]
  }

  Note: 'Tasa del dólar por día.'
}

Table inventory_movements [headercolor: #6B4E8C] {
  id uuid [pk]
  product_id uuid [not null]
  type text [not null]
  quantity integer [not null]
  unit_cost "numeric(14,4)" [not null, default: 0]
  stock_after integer [not null]
  reason text [not null, default: '']
  source_type text
  source_id uuid
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Kardex inmutable: cada entrada y salida con su saldo (stock_after).'
}

Table purchases [headercolor: #6B4E8C] {
  id uuid [pk]
  supplier_id uuid [not null]
  supplier_invoice_number text [not null, default: '']
  status text [not null, default: 'draft']
  purchase_date date [not null, default: `CURRENT_DATE`]
  subtotal "numeric(14,2)" [not null, default: 0]
  tax "numeric(14,2)" [not null, default: 0]
  total "numeric(14,2)" [not null, default: 0]
  notes text [not null, default: '']
  created_by uuid [not null]
  received_by uuid
  received_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  void_reason text [not null, default: '']
  voided_by uuid
  voided_at timestamptz

  Note: 'Compras a proveedores: borrador, recibida o anulada.'
}

Table purchase_items [headercolor: #6B4E8C] {
  id uuid [pk]
  purchase_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]
  unit_cost "numeric(14,4)" [not null]
  subtotal "numeric(14,2)" [not null]
  expires_on date
  expiry_alerted_at timestamptz

  indexes {
    (purchase_id, product_id) [unique]
  }

  Note: 'Líneas de compra; expires_on alimenta el control de vencimientos (FIFO).'
}

Table suppliers [headercolor: #6B4E8C] {
  id uuid [pk]
  name text [not null]
  tax_id citext [unique]
  contact_name text [not null, default: '']
  phone text
  email citext
  address text [not null, default: '']
  credit_days integer [not null, default: 0]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Proveedores.'
}

Table settings [headercolor: #5E5A55] {
  key text [pk]
  value jsonb [not null]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Configuración del negocio en JSON por clave (negocio, horario, respaldos...).'
}

Table email_queue [headercolor: #5E5A55] {
  id uuid [pk]
  template_key text
  to_address citext [not null]
  subject text [not null]
  html_body text [not null]
  status text [not null, default: 'pending']
  attempts integer [not null, default: 0]
  last_error text
  scheduled_at timestamptz [not null, default: `now()`]
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'Cola de correos con reintentos.'
}

Table email_templates [headercolor: #5E5A55] {
  key text [pk]
  subject text [not null]
  html_body text [not null]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Plantillas de correo.'
}

Table backups [headercolor: #5E5A55] {
  id uuid [pk]
  file_name text [not null, unique]
  size_bytes bigint
  checksum_sha256 character
  kind text [not null]
  status text [not null, default: 'running']
  error text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  remote_key text
  verified_at timestamptz
  verification jsonb

  Note: 'Respaldos de la base: manual o automático, copia externa y simulacro de restauración.'
}

TableGroup "Seguridad y acceso" {
  users
  roles
  permissions
  role_permissions
  refresh_sessions
  auth_tokens
  password_history
  schedule_extensions
  audit_log
}

TableGroup "Catálogo" {
  products
  product_presentations
  categories
  brands
  units
}

TableGroup "Ventas y devoluciones" {
  sales
  sale_items
  sale_payments
  returns
  return_items
  customers
}

TableGroup "Caja y moneda" {
  registers
  cash_shifts
  cash_movements
  currencies
  exchange_rates
}

TableGroup "Inventario y compras" {
  inventory_movements
  purchases
  purchase_items
  suppliers
}

TableGroup "Sistema" {
  settings
  email_queue
  email_templates
  backups
}

Ref: audit_log.user_id > users.id [delete: set null]
Ref: auth_tokens.user_id > users.id [delete: cascade]
Ref: backups.created_by > users.id [delete: set null]
Ref: cash_movements.created_by > users.id [delete: restrict]
