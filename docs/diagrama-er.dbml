Ref: purchases.created_by > users.id [delete: restrict]
Ref: purchases.received_by > users.id [delete: restrict]
Ref: purchases.supplier_id > suppliers.id [delete: restrict]
Ref: purchases.voided_by > users.id [delete: restrict]
Ref: refresh_sessions.user_id > users.id [delete: cascade]
Ref: return_items.return_id > returns.id [delete: cascade]
Ref: return_items.sale_item_id > sale_items.id [delete: restrict]
Ref: returns.authorized_by > users.id [delete: restrict]
Ref: returns.created_by > users.id [delete: restrict]
Ref: returns.sale_id > sales.id [delete: restrict]
Ref: returns.shift_id > cash_shifts.id [delete: restrict]
Ref: role_permissions.permission_id > permissions.id [delete: cascade]
Ref: role_permissions.role_id > roles.id [delete: cascade]
Ref: sale_items.presentation_id > product_presentations.id [delete: restrict]
Ref: sale_items.product_id > products.id [delete: restrict]
Ref: sale_items.sale_id > sales.id [delete: cascade]
Ref: sale_payments.currency_code > currencies.code [delete: restrict]
Ref: sale_payments.sale_id > sales.id [delete: cascade]
