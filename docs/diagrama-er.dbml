Ref: sales.user_id > users.id [delete: restrict]
Ref: sales.voided_by > users.id [delete: restrict]
Ref: schedule_extensions.created_by > users.id
Ref: schedule_extensions.user_id > users.id
Ref: settings.updated_by > users.id [delete: set null]
Ref: users.role_id > roles.id [delete: restrict]
